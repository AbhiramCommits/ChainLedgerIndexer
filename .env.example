# Ethereum RPC endpoint
RPC_URL=http://anvil:8545
# Postgres connection string (SQLAlchemy URL)
DB_URL=postgresql+psycopg://chainledger:chainledger@postgres:5432/chainledger
# Chain ID of the network being indexed (31337 = anvil default)
CHAIN_ID=31337
# Comma-separated ERC-20 token addresses to index (lowercase hex)
TOKENS=
# Block to start indexing from
START_BLOCK=0
# Number of confirmations required before indexing a block
CONFIRMATIONS=5
# Seconds between indexer poll cycles
POLL_INTERVAL_SECONDS=3
# Max blocks fetched per poll cycle
BATCH_SIZE=500

# Postgres credentials used by docker-compose
POSTGRES_USER=chainledger
POSTGRES_PASSWORD=chainledger
POSTGRES_DB=chainledger
